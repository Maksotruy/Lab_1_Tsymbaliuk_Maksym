
@inject IConfiguration Config

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand"
           href="/"
           data-enhance-nav="false"
           style="white-space: normal;
                  overflow-wrap: anywhere;
                  font-size: 16px;
                  line-height: 1.4;
                  max-width: 100%;
                  margin-right: 0;">
            ⚽ @Config["FootballMatches:Title"]
        </a>
    </div>
</div>

<input type="checkbox"
       title="Відкрити або закрити меню навігації"
       aria-label="Меню навігації"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler')?.click()">

    <nav class="nav flex-column"
         aria-label="Основна навігація">

        <!-- Головна -->
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All"
                     data-enhance-nav="false">
                <span class="bi bi-house-door-fill-nav-menu"
                      aria-hidden="true"></span>
                Головна
            </NavLink>
        </div>

        <!-- Футбольні матчі -->
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="footballmatches"
                     Match="NavLinkMatch.Prefix"
                     data-enhance-nav="false">
                <span class="bi bi-list-nested-nav-menu"
                      aria-hidden="true"></span>
                Футбольні матчі
            </NavLink>
        </div>

        <!-- Команди -->
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="teams"
                     Match="NavLinkMatch.Prefix"
                     data-enhance-nav="false">
                <span class="bi bi-people-fill"
                      aria-hidden="true"></span>
                Команди
            </NavLink>
        </div>

        <!-- Стадіони -->
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="stadiums"
                     Match="NavLinkMatch.Prefix"
                     data-enhance-nav="false">
                <span class="bi bi-building"
                      aria-hidden="true"></span>
                Стадіони
            </NavLink>
        </div>

        <!-- Статистика -->
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="summary"
                     Match="NavLinkMatch.Prefix"
                     data-enhance-nav="false">
                <span class="bi bi-bar-chart-fill"
                      aria-hidden="true"></span>
                Статистика
            </NavLink>
        </div>

    </nav>
</div>
