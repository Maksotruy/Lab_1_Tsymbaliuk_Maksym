
@page "/stadiums/edit"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models

@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit Stadium</PageTitle>

<h1>Edit Stadium</h1>
<hr />

@if (Stadium is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">

            <EditForm method="post"
                      Model="Stadium"
                      OnValidSubmit="UpdateStadium"
                      FormName="edit"
                      Enhance>

                <DataAnnotationsValidator />

                <ValidationSummary class="text-danger"
                                   role="alert" />

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger"
                         role="alert">
                        @error
                    </div>
                }

                <input type="hidden"
                       name="Stadium.Id"
                       value="@Stadium.Id" />

                <div class="mb-3">
                    <label for="name" class="form-label">
                        Name <span class="text-danger">*</span>
                    </label>

                    <InputText id="name"
                               @bind-Value="Stadium.Name"
                               class="form-control"
                               aria-required="true" />

                    <ValidationMessage
                        For="() => Stadium.Name"
                        class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="city" class="form-label">
                        City <span class="text-danger">*</span>
                    </label>

                    <InputText id="city"
                               @bind-Value="Stadium.City"
                               class="form-control"
                               aria-required="true" />

                    <ValidationMessage
                        For="() => Stadium.City"
                        class="text-danger" />
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-success animated-btn">
                        ✔ Save Changes
                    </button>

                    <a href="/stadiums"
                       class="btn btn-secondary animated-btn">
                        ← Back to List
                    </a>

                </div>

            </EditForm>

        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Stadium? Stadium { get; set; }

    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await using var context =
            await DbFactory.CreateDbContextAsync();

        Stadium ??= await context.Stadium
            .AsNoTracking()
            .FirstOrDefaultAsync(s => s.Id == Id);

        if (Stadium is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateStadium()
    {
        error = null;

        if (Stadium is null)
        {
            error = "Unable to load stadium data.";
            return;
        }

        await using var context =
            await DbFactory.CreateDbContextAsync();

        var existingStadium = await context.Stadium
            .FirstOrDefaultAsync(s => s.Id == Stadium.Id);

        if (existingStadium is null)
        {
            error = "The stadium no longer exists in the database.";
            return;
        }

        existingStadium.Name = Stadium.Name;
        existingStadium.City = Stadium.City;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            error = "Unable to update the stadium because its data has changed.";
            return;
        }
        catch (DbUpdateException)
        {
            error = "Unable to save changes. Please try again.";
            return;
        }

        NavigationManager.NavigateTo("/stadiums");
    }
}
