
@page "/stadiums/delete"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models

@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалення стадіону | FootballMatches</PageTitle>

<h1>Видалення стадіону</h1>
<hr />

@if (stadium is null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-8">

            <div class="alert alert-danger" role="alert">
                <strong>Увага!</strong>
                Ви впевнені, що хочете видалити цей стадіон?
                Цю дію неможливо скасувати.
            </div>

            <div class="card mb-4">

                <div class="card-header">
                    <h5 class="mb-0">
                        Інформація про стадіон
                    </h5>
                </div>

                <div class="card-body">
                    <dl class="row">

                        <dt class="col-sm-4">
                            Назва стадіону
                        </dt>

                        <dd class="col-sm-8">
                            @stadium.Name
                        </dd>

                        <dt class="col-sm-4">
                            Місто
                        </dt>

                        <dd class="col-sm-8">
                            @stadium.City
                        </dd>

                    </dl>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger"
                     role="alert">
                    @error
                </div>
            }

            <EditForm method="post"
                      Model="stadium"
                      OnSubmit="DeleteStadium"
                      FormName="delete"
                      Enhance
                      class="mt-4">

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-danger animated-btn">
                        🗑 Видалити стадіон
                    </button>

                    <a href="/stadiums"
                       class="btn btn-secondary animated-btn">
                        ← Повернутися до списку
                    </a>

                </div>

            </EditForm>

        </div>
    </div>
}

@code {
    private Stadium? stadium;
    private string? error;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context =
            await DbFactory.CreateDbContextAsync();

        stadium = await context.Stadium
            .AsNoTracking()
            .FirstOrDefaultAsync(s => s.Id == Id);

        if (stadium is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteStadium(EditContext editContext)
    {
        error = null;

        if (stadium is null)
        {
            error = "Не вдалося завантажити дані стадіону.";
            return;
        }

        await using var context =
            await DbFactory.CreateDbContextAsync();

        var existingStadium = await context.Stadium
            .FirstOrDefaultAsync(s => s.Id == stadium.Id);

        if (existingStadium is null)
        {
            error = "Цього стадіону більше немає в базі даних.";
            return;
        }

        // Перевірка, чи використовується стадіон у футбольних матчах.
        var isUsed = await context.FootballMatches
            .AnyAsync(m => m.StadiumId == existingStadium.Id);

        if (isUsed)
        {
            error = "Неможливо видалити цей стадіон, оскільки він використовується в одному або декількох футбольних матчах.";
            return;
        }

        context.Stadium.Remove(existingStadium);

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            error = "Не вдалося видалити стадіон. Спробуйте ще раз.";
            return;
        }

        NavigationManager.NavigateTo("/stadiums");
    }
}
