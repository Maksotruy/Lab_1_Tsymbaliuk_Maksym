
@page "/stadiums/create"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models

@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Stadium</PageTitle>

<h1>Create Stadium</h1>
<hr />

<div class="row">
    <div class="col-md-4">

        <EditForm method="post"
                  Model="Stadium"
                  OnValidSubmit="AddStadium"
                  FormName="create"
                  Enhance>

            <DataAnnotationsValidator />

            <ValidationSummary class="text-danger"
                               role="alert" />

            <div class="mb-3">
                <label for="name" class="form-label">
                    Name <span class="text-danger">*</span>
                </label>

                <InputText id="name"
                           @bind-Value="Stadium.Name"
                           class="form-control"
                           aria-required="true" />

                <ValidationMessage
                    For="() => Stadium.Name"
                    class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="city" class="form-label">
                    City <span class="text-danger">*</span>
                </label>

                <InputText id="city"
                           @bind-Value="Stadium.City"
                           class="form-control"
                           aria-required="true" />

                <ValidationMessage
                    For="() => Stadium.City"
                    class="text-danger" />
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">

                <button type="submit"
                        class="btn btn-success animated-btn">
                    ✔ Create Stadium
                </button>

                <a href="/stadiums"
                   class="btn btn-secondary animated-btn">
                    ← Back to List
                </a>

            </div>

        </EditForm>

    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Stadium Stadium { get; set; } = default!;

    protected override void OnInitialized()
    {
        Stadium ??= new();
    }

    // Save the new stadium to the database.
    private async Task AddStadium()
    {
        using var context = DbFactory.CreateDbContext();

        context.Stadium.Add(Stadium);

        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/stadiums");
    }
}
