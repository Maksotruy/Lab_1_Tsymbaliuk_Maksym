
@page "/stadiums"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models
@using FootballMatches.Data

@inject IDbContextFactory<FootballMatchesContext> DbFactory

<PageTitle>Стадіони | FootballMatches</PageTitle>

<div class="container-fluid px-0">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h1 class="fw-bold mb-2">
                Список стадіонів
            </h1>

            <p class="text-muted mb-0">
                Перегляд та керування футбольними стадіонами.
            </p>
        </div>

        <a href="/stadiums/create"
           class="btn btn-success animated-btn">
            ➕ Додати стадіон
        </a>

    </div>

    @if (!loaded)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"
                 role="status">
                <span class="visually-hidden">
                    Завантаження...
                </span>
            </div>
        </div>
    }
    else if (totalStadiums == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <h3>Стадіонів не знайдено</h3>

                <p class="text-muted">
                    У базі даних поки немає жодного стадіону.
                </p>

                <a href="/stadiums/create"
                   class="btn btn-success animated-btn">
                    ➕ Додати стадіон
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3 p-md-4">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

                    <h5 class="fw-bold mb-0">
                        Перелік стадіонів
                    </h5>

                    <span class="badge bg-primary rounded-pill">
                        Усього: @totalStadiums
                    </span>

                </div>

                <div class="row g-3">

                    @foreach (var stadium in stadiumList)
                    {
                        <div class="col-12 col-md-6 col-xl-4">

                            <div class="card border shadow-sm h-100">
                                <div class="card-body p-3 d-flex flex-column">

                                    <h5 class="fw-bold text-break mb-3">
                                        @stadium.Name
                                    </h5>

                                    <div class="mb-3">
                                        <span class="text-muted">
                                            Місто:
                                        </span>

                                        <span class="fw-semibold text-break">
                                            @stadium.City
                                        </span>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 mt-auto">

                                        <a href="@($"/stadiums/edit?id={stadium.Id}")"
                                           class="btn btn-sm btn-primary animated-btn flex-fill">
                                            ✏️ Редагувати
                                        </a>

                                        <a href="@($"/stadiums/details?id={stadium.Id}")"
                                           class="btn btn-sm animated-btn text-white flex-fill"
                                           style="background-color: #fd7e14; border-color: #fd7e14;">
                                            👁 Деталі
                                        </a>

                                        <a href="@($"/stadiums/delete?id={stadium.Id}")"
                                           class="btn btn-sm btn-danger animated-btn w-100">
                                            🗑 Видалити
                                        </a>

                                    </div>

                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 mb-3">

            <span class="text-muted small">
                Сторінка @currentPage із @totalPages
            </span>

            <div class="d-flex flex-wrap align-items-center gap-2">

                @if (currentPage > 1)
                {
                    <a href="@($"/stadiums?page={currentPage - 1}")"
                       data-enhance-nav="false"
                       class="btn btn-warning animated-btn">
                        ← Назад
                    </a>
                }

                <span class="badge bg-light text-dark border px-3 py-2">
                    @currentPage / @totalPages
                </span>

                @if (currentPage < totalPages)
                {
                    <a href="@($"/stadiums?page={currentPage + 1}")"
                       data-enhance-nav="false"
                       class="btn btn-warning animated-btn">
                        Далі →
                    </a>
                }

            </div>

        </div>
    }

</div>

@code {
    private List<Stadium> stadiumList = new();

    // 12 стадіонів на одній сторінці
    private const int pageSize = 12;

    private int currentPage = 1;
    private int totalPages = 1;
    private int totalStadiums = 0;

    private bool loaded = false;

    [SupplyParameterFromQuery(Name = "page")]
    private int? Page { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;

        await using var context =
            await DbFactory.CreateDbContextAsync();

        totalStadiums = await context.Stadium.CountAsync();

        totalPages = Math.Max(
            1,
            (int)Math.Ceiling(totalStadiums / (double)pageSize)
        );

        currentPage = Math.Clamp(Page ?? 1, 1, totalPages);

        stadiumList = await context.Stadium
            .AsNoTracking()
            .OrderBy(s => s.Id)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();

        loaded = true;
    }
}
