
@page "/footballmatches/details"
@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models
@using FootballMatches.Components
@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>FootballMatch</h2>
    <hr />

    @if (footballmatch is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <FootballMatchCard FootballMatch="footballmatch"
                           Caption="Детальна інформація про матч"
                           ShowDetails="true" />

        <div>
            <a href="@($"/footballmatches/edit?id={footballmatch.Id}")">Edit</a> |
            <a href="/footballmatches">Back to List</a>
        </div>
    }
</div>

@code {
    private FootballMatch? footballmatch;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        footballmatch = await context.FootballMatches
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (footballmatch is null)
        {
            NavigationManager.NotFound();
        }
    }
}
