
@page "/footballmatches/details"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models
@using FootballMatches.Components

@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Деталі матчу | FootballMatches</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-2">Деталі матчу</h1>
            <p class="text-muted mb-0">Перегляд повної інформації про футбольний матч.</p>
        </div>
        <a href="/footballmatches" class="btn btn-outline-secondary animated-btn">
            ← Повернутися до матчів
        </a>
    </div>

    @if (footballmatch is null)
    {
        <div class="text-center py-5" role="status">
            <div class="spinner-border text-primary" aria-hidden="true"></div>
            <p class="text-muted mt-3">Завантаження інформації про матч...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-xl-9">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4 p-md-5 text-center">
                        <span class="badge bg-light text-dark border mb-3 px-3 py-2">
                            @GetStatusText(footballmatch.Status)
                        </span>

                        <div class="row align-items-center g-3">
                            <div class="col-12 col-md-5">
                                <div class="text-muted small text-uppercase fw-semibold mb-2">
                                    Домашня команда
                                </div>
                                <h3 class="fw-bold mb-0 text-break">@HomeTeamName</h3>
                            </div>

                            <div class="col-12 col-md-2">
                                <div class="display-5 fw-bold text-primary text-nowrap">
                                    @footballmatch.HomeScore : @footballmatch.AwayScore
                                </div>
                            </div>

                            <div class="col-12 col-md-5">
                                <div class="text-muted small text-uppercase fw-semibold mb-2">
                                    Гостьова команда
                                </div>
                                <h3 class="fw-bold mb-0 text-break">@AwayTeamName</h3>
                            </div>
                        </div>

                        <div class="text-muted mt-4">
                            @footballmatch.MatchDate.ToString("dd.MM.yyyy")
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom p-3 p-md-4">
                        <h5 class="fw-bold mb-0">Інформація про матч</h5>
                    </div>

                    <div class="card-body p-3 p-md-4">
                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">Домашня команда</div>
                                <div class="fw-semibold text-break">@HomeTeamName</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">Гостьова команда</div>
                                <div class="fw-semibold text-break">@AwayTeamName</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">Голи домашньої команди</div>
                                <div class="fw-semibold">@footballmatch.HomeScore</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">Голи гостьової команди</div>
                                <div class="fw-semibold">@footballmatch.AwayScore</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">Дата матчу</div>
                                <div class="fw-semibold">
                                    @footballmatch.MatchDate.ToString("dd.MM.yyyy")
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">Стадіон</div>
                                <div class="fw-semibold text-break">@StadiumName</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">Турнір</div>
                                <div class="fw-semibold text-break">@CompetitionName</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">Статус матчу</div>
                                <div class="fw-semibold">
                                    @GetStatusText(footballmatch.Status)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold mb-3">Картка матчу</h5>

                    <FootballMatchCard FootballMatch="footballmatch"
                                       Caption="Інформація про футбольний матч"
                                       ShowDetails="true" />
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <a href="@($"/footballmatches/edit?id={footballmatch.Id}")"
                       class="btn btn-primary animated-btn">
                        Редагувати матч
                    </a>

                    <a href="/footballmatches"
                       class="btn btn-secondary animated-btn">
                        ← Повернутися до матчів
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private FootballMatch? footballmatch;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private string HomeTeamName =>
        footballmatch?.HomeTeamReference?.Name
        ?? footballmatch?.HomeTeam
        ?? "Не вказано";

    private string AwayTeamName =>
        footballmatch?.AwayTeamReference?.Name
        ?? footballmatch?.AwayTeam
        ?? "Не вказано";

    private string StadiumName =>
        footballmatch?.StadiumReference?.Name
        ?? footballmatch?.Stadium
        ?? "Не вказано";

    private string CompetitionName =>
        string.IsNullOrWhiteSpace(footballmatch?.Competition)
            ? "Не вказано"
            : footballmatch.Competition;

    private static string GetStatusText(MatchStatus status)
    {
        return status.ToString() switch
        {
            "Scheduled" => "Заплановано",
            "InProgress" => "Триває",
            "Finished" => "Завершено",
            "Completed" => "Завершено",
            "Cancelled" => "Скасовано",
            "Postponed" => "Перенесено",
            _ => status.ToString()
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        footballmatch = await context.FootballMatches
            .Include(m => m.HomeTeamReference)
            .Include(m => m.AwayTeamReference)
            .Include(m => m.StadiumReference)
            .AsNoTracking()
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (footballmatch is null)
        {
            NavigationManager.NotFound();
        }
    }
}
