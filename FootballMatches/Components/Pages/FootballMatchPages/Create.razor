
@page "/footballmatches/create"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Data.Sqlite
@using FootballMatches.Models
@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Створення матчу</PageTitle>

<h1>Створення футбольного матчу</h1>
<hr />

<div class="row">
    <div class="col-md-4">

        <EditForm method="post"
                  Model="FootballMatch"
                  OnValidSubmit="AddFootballMatch"
                  FormName="create"
                  Enhance>

            <DataAnnotationsValidator />

            <ValidationSummary class="text-danger" role="alert" />

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger" role="alert">
                    @error
                </div>
            }

            <div class="mb-3">
                <label for="hometeam" class="form-label">
                    Домашня команда:
                </label>

                <InputText id="hometeam"
                           @bind-Value="FootballMatch.HomeTeam"
                           class="form-control" />

                <ValidationMessage For="() => FootballMatch.HomeTeam"
                                   class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="awayteam" class="form-label">
                    Гостьова команда:
                </label>

                <InputText id="awayteam"
                           @bind-Value="FootballMatch.AwayTeam"
                           class="form-control" />

                <ValidationMessage For="() => FootballMatch.AwayTeam"
                                   class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="homescore" class="form-label">
                    Голи домашньої команди:
                </label>

                <InputNumber id="homescore"
                             @bind-Value="FootballMatch.HomeScore"
                             class="form-control" />

                <ValidationMessage For="() => FootballMatch.HomeScore"
                                   class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="awayscore" class="form-label">
                    Голи гостьової команди:
                </label>

                <InputNumber id="awayscore"
                             @bind-Value="FootballMatch.AwayScore"
                             class="form-control" />

                <ValidationMessage For="() => FootballMatch.AwayScore"
                                   class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="matchdate" class="form-label">
                    Дата матчу:
                </label>

                <InputDate id="matchdate"
                           @bind-Value="FootballMatch.MatchDate"
                           class="form-control" />

                <ValidationMessage For="() => FootballMatch.MatchDate"
                                   class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="stadium" class="form-label">
                    Стадіон:
                </label>

                <InputText id="stadium"
                           @bind-Value="FootballMatch.Stadium"
                           class="form-control" />

                <ValidationMessage For="() => FootballMatch.Stadium"
                                   class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="status" class="form-label">
                    Статус матчу:
                </label>

                <InputSelect id="status"
                             @bind-Value="FootballMatch.Status"
                             class="form-control">

                    @foreach (var status in Enum.GetValues<MatchStatus>())
                    {
                        <option value="@status">@status</option>
                    }

                </InputSelect>

                <ValidationMessage For="() => FootballMatch.Status"
                                   class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">
                Створити матч
            </button>

        </EditForm>
    </div>
</div>

<div class="mt-3">
    <a href="/footballmatches">Повернутися до списку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private FootballMatch FootballMatch { get; set; } = default!;

    private string? error;

    protected override void OnInitialized()
    {
        FootballMatch ??= new FootballMatch
        {
            MatchDate = DateOnly.FromDateTime(DateTime.Today)
        };
    }

    private async Task AddFootballMatch()
    {
        error = null;

        // Перевірка назв команд
        FootballMatch.HomeTeam = FootballMatch.HomeTeam?.Trim() ?? "";
        FootballMatch.AwayTeam = FootballMatch.AwayTeam?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(FootballMatch.HomeTeam) ||
            string.IsNullOrWhiteSpace(FootballMatch.AwayTeam))
        {
            error = "Вкажіть назви обох команд.";
            return;
        }

        if (string.Equals(
            FootballMatch.HomeTeam,
            FootballMatch.AwayTeam,
            StringComparison.OrdinalIgnoreCase))
        {
            error = "Домашня та гостьова команди не можуть бути однаковими.";
            return;
        }

        // Перевірка дати
        if (FootballMatch.MatchDate == default)
        {
            error = "Вкажіть правильну дату проведення матчу.";
            return;
        }

        // Перевірка статусу та рахунку
        if (FootballMatch.Status == MatchStatus.Scheduled &&
            (FootballMatch.HomeScore != 0 ||
             FootballMatch.AwayScore != 0))
        {
            error = "Запланований матч повинен мати рахунок 0:0.";
            return;
        }

        using var context = DbFactory.CreateDbContext();

        context.FootballMatches.Add(FootballMatch);

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
            when (ex.InnerException is SqliteException
            { SqliteExtendedErrorCode: 2067 })
        {
            error = "Матч між цими командами на цю дату вже існує.";
            return;
        }
        catch (DbUpdateException)
        {
            error = "Не вдалося зберегти матч у базі даних. Спробуйте ще раз.";
            return;
        }

        NavigationManager.NavigateTo("/footballmatches");
    }
}
