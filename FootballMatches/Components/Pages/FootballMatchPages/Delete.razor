@page "/footballmatches/delete"
@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models
@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>FootballMatch</h2>
    <hr />
    @if (footballmatch is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">HomeTeam</dt>
            <dd class="col-sm-10">@footballmatch.HomeTeam</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">AwayTeam</dt>
            <dd class="col-sm-10">@footballmatch.AwayTeam</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">HomeScore</dt>
            <dd class="col-sm-10">@footballmatch.HomeScore</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">AwayScore</dt>
            <dd class="col-sm-10">@footballmatch.AwayScore</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">MatchDate</dt>
            <dd class="col-sm-10">@footballmatch.MatchDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Stadium</dt>
            <dd class="col-sm-10">@footballmatch.Stadium</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@footballmatch.Status</dd>
        </dl>
        <EditForm method="post" Model="footballmatch" OnValidSubmit="DeleteFootballMatch" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(footballmatch is null)">Delete</button> |
            <a href="/footballmatches">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private FootballMatch? footballmatch;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        footballmatch = await context.FootballMatches.FirstOrDefaultAsync(m => m.Id == Id);

        if (footballmatch is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteFootballMatch()
    {
        using var context = DbFactory.CreateDbContext();
        context.FootballMatches.Remove(footballmatch!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/footballmatches");
    }
}
