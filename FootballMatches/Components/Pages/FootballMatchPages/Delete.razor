
@page "/footballmatches/delete"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models
@using FootballMatches.Components
@using Microsoft.AspNetCore.Components.Forms

@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager
@inject ILogger<Delete> Logger

<PageTitle>Видалення футбольного матчу | FootballMatches</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-2">Видалення футбольного матчу</h1>
            <p class="text-muted mb-0">
                Перевірте інформацію про матч перед остаточним видаленням запису.
            </p>
        </div>

        <a href="/footballmatches"
           class="btn btn-outline-secondary animated-btn">
            ← Повернутися до матчів
        </a>
    </div>

    @if (footballmatch is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Завантаження...</span>
            </div>

            <p class="text-muted mt-3">
                Завантаження інформації про матч...
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-xl-9">

                <div class="alert alert-danger border-0 shadow-sm mb-4"
                     role="alert">
                    <h5 class="alert-heading fw-bold mb-2">
                        ⚠ Підтвердження видалення
                    </h5>

                    <p class="mb-1">
                        Ви впевнені, що хочете видалити цей футбольний матч?
                    </p>

                    <strong>Цю дію неможливо скасувати.</strong>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">

                        <p class="text-uppercase text-muted small fw-semibold mb-2">
                            Вибраний матч
                        </p>

                        <h2 class="h4 fw-bold mb-2">
                            @(footballmatch.HomeTeamReference?.Name ?? footballmatch.HomeTeam)
                            <span class="text-muted fw-normal">проти</span>
                            @(footballmatch.AwayTeamReference?.Name ?? footballmatch.AwayTeam)
                        </h2>

                        <p class="text-muted mb-0">
                            @footballmatch.MatchDate.ToString("dd.MM.yyyy")
                        </p>

                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom py-3 px-4">
                        <h5 class="fw-bold mb-0">
                            Інформація про матч
                        </h5>
                    </div>

                    <div class="card-body p-4">
                        <div class="row g-4">

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">
                                    Домашня команда
                                </div>

                                <div class="fw-semibold">
                                    @(footballmatch.HomeTeamReference?.Name ?? footballmatch.HomeTeam)
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">
                                    Гостьова команда
                                </div>

                                <div class="fw-semibold">
                                    @(footballmatch.AwayTeamReference?.Name ?? footballmatch.AwayTeam)
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">
                                    Голи домашньої команди
                                </div>

                                <div class="fw-semibold">
                                    @footballmatch.HomeScore
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">
                                    Голи гостьової команди
                                </div>

                                <div class="fw-semibold">
                                    @footballmatch.AwayScore
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">
                                    Дата матчу
                                </div>

                                <div class="fw-semibold">
                                    @footballmatch.MatchDate.ToString("dd.MM.yyyy")
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">
                                    Стадіон
                                </div>

                                <div class="fw-semibold">
                                    @(footballmatch.StadiumReference?.Name
                                        ?? footballmatch.Stadium
                                        ?? "Не вказано")
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">
                                    Турнір
                                </div>

                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(footballmatch.Competition)
                                        ? "Не вказано"
                                        : footballmatch.Competition)
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="text-muted small mb-1">
                                    Статус матчу
                                </div>

                                <div class="fw-semibold">
                                    @GetStatusText(footballmatch.Status)
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <h5 class="fw-bold mb-3">
                    Картка матчу
                </h5>

                <FootballMatchCard FootballMatch="footballmatch"
                                   Caption="Матч, вибраний для видалення"
                                   ShowDetails="false" />

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger mt-4" role="alert">
                        @error
                    </div>
                }

                <EditForm method="post"
                          Model="footballmatch"
                          OnSubmit="DeleteFootballMatch"
                          FormName="delete"
                          Enhance
                          class="mt-4">

                    <input type="hidden"
                           name="Id"
                           value="@footballmatch.Id" />

                    <div class="d-flex flex-wrap gap-2 mb-3">

                        <button type="submit"
                                class="btn btn-danger animated-btn px-4">
                            Видалити матч
                        </button>

                        <a href="/footballmatches"
                           class="btn btn-outline-secondary animated-btn px-4">
                            Скасувати
                        </a>

                    </div>
                </EditForm>

            </div>
        </div>
    }
</div>

@code {
    private FootballMatch? footballmatch;
    private string? error;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private static string GetStatusText(MatchStatus status)
    {
        return status.ToString() switch
        {
            "Scheduled" => "Заплановано",
            "InProgress" => "Триває",
            "Finished" => "Завершено",
            "Completed" => "Завершено",
            "Cancelled" => "Скасовано",
            "Postponed" => "Перенесено",
            _ => status.ToString()
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        footballmatch = await context.FootballMatches
            .Include(m => m.HomeTeamReference)
            .Include(m => m.AwayTeamReference)
            .Include(m => m.StadiumReference)
            .AsNoTracking()
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (footballmatch is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteFootballMatch(EditContext editContext)
    {
        error = null;

        await using var context = await DbFactory.CreateDbContextAsync();

        var match = await context.FootballMatches
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (match is null)
        {
            error = "Футбольний матч більше не існує.";
            return;
        }

        context.FootballMatches.Remove(match);

        try
        {
            await context.SaveChangesAsync();
            Logger.LogInformation("Видалено футбольний матч ID={MatchId}", match.Id);
        }
        catch (DbUpdateException)
        {
            error = "Не вдалося видалити матч. Спробуйте ще раз.";
            return;
        }

        NavigationManager.NavigateTo("/footballmatches");
    }
}
