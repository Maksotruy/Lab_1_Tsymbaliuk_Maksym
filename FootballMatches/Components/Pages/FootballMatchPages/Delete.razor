
@page "/footballmatches/delete"
@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models
@using FootballMatches.Components
@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>

<div>
    <h2>FootballMatch</h2>
    <hr />

    @if (footballmatch is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <FootballMatchCard FootballMatch="footballmatch"
                           Caption="Матч, який буде видалено"
                           ShowDetails="false" />

        <EditForm method="post"
                  Model="footballmatch"
                  OnValidSubmit="DeleteFootballMatch"
                  FormName="delete"
                  Enhance>
            <input type="hidden" name="Id" value="@footballmatch.Id" />
            <button type="submit" class="btn btn-danger">Delete</button> |
            <a href="/footballmatches">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private FootballMatch? footballmatch;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        footballmatch = await context.FootballMatches
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (footballmatch is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteFootballMatch()
    {
        using var context = DbFactory.CreateDbContext();

        var match = await context.FootballMatches
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (match is null)
        {
            NavigationManager.NotFound();
            return;
        }

        context.FootballMatches.Remove(match);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/footballmatches");
    }
}
