
@page "/footballmatches"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using FootballMatches.Models
@using FootballMatches.Data

@inject IDbContextFactory<FootballMatchesContext> DbFactory
@inject IConfiguration Config

<PageTitle>Футбольні матчі | FootballMatches</PageTitle>

<div class="container-fluid px-0">

    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <h1 class="fw-bold mb-2">Футбольні матчі</h1>
            <p class="text-muted mb-0">
                Перегляд, пошук і керування футбольними матчами.
            </p>
        </div>

        <a href="/footballmatches/create"
           class="btn btn-success animated-btn">
            + Додати матч
        </a>
    </div>

    @if (Saved)
    {
        <div class="alert alert-success" role="status">
            <strong>Успішно!</strong>
            Футбольний матч успішно збережено.
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <h5 class="fw-semibold mb-3">
                Пошук і фільтри
            </h5>

            <form method="get" class="row g-3">

                <div class="col-12 col-md-6 col-xl-3">
                    <label for="search" class="form-label">
                        Пошук домашньої команди
                    </label>

                    <input id="search"
                           type="text"
                           name="search"
                           value="@Search"
                           class="form-control"
                           placeholder="Введіть назву команди" />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label for="teamId" class="form-label">
                        Фільтр за командою
                    </label>

                    <select id="teamId"
                            name="teamId"
                            class="form-select">

                        <option value="">Усі команди</option>

                        @foreach (var team in teams)
                        {
                            <option value="@team.Id"
                                    selected="@(TeamId == team.Id)">
                                @team.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label for="sort" class="form-label">
                        Сортувати за
                    </label>

                    <select id="sort"
                            name="sort"
                            class="form-select">

                        <option value="date_desc"
                                selected="@(Sort == "date_desc" || string.IsNullOrEmpty(Sort))">
                            Спочатку новіші
                        </option>

                        <option value="date_asc"
                                selected="@(Sort == "date_asc")">
                            Спочатку старіші
                        </option>

                        <option value="score_desc"
                                selected="@(Sort == "score_desc")">
                            Найбільше голів господарів
                        </option>

                        <option value="score_asc"
                                selected="@(Sort == "score_asc")">
                            Найменше голів господарів
                        </option>

                        <option value="team_asc"
                                selected="@(Sort == "team_asc")">
                            Домашня команда (А–Я)
                        </option>

                        <option value="team_desc"
                                selected="@(Sort == "team_desc")">
                            Домашня команда (Я–А)
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-3
                            d-flex align-items-end gap-2">

                    <button type="submit"
                            class="btn btn-primary animated-btn">
                        Знайти
                    </button>

                    <a href="/footballmatches"
                       class="btn btn-outline-secondary animated-btn">
                        Скинути
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (!loaded)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"
                 role="status">
                <span class="visually-hidden">Завантаження...</span>
            </div>

            <p class="text-muted mt-3">
                Завантаження матчів...
            </p>
        </div>
    }
    else if (totalMatches == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <h3 class="fw-bold mb-3">
                    Матчів не знайдено
                </h3>

                <p class="text-muted mb-4">
                    За заданими умовами пошуку матчів не знайдено,
                    або матчі ще не додано.
                    Змініть фільтри або додайте новий матч.
                </p>

                <div class="d-flex flex-wrap
                            justify-content-center gap-2">

                    <a href="/footballmatches/create"
                       class="btn btn-success animated-btn">
                        + Додати матч
                    </a>

                    <a href="/footballmatches"
                       class="btn btn-outline-primary animated-btn">
                        Очистити фільтри
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3 p-md-4">

                <div class="d-flex flex-wrap
                            justify-content-between
                            align-items-center gap-2 mb-3">

                    <h5 class="fw-bold mb-0">
                        Список матчів
                    </h5>

                    <span class="badge bg-primary rounded-pill">
                        Знайдено: @totalMatches
                    </span>
                </div>

                <div class="d-none d-xxl-block table-responsive football-table">

                    <QuickGrid Class="table table-striped table-hover align-middle"
                               Items="matches">

                        <PropertyColumn
                            Property="match => match.HomeTeam"
                            Title="Домашня команда" />

                        <PropertyColumn
                            Property="match => match.AwayTeam"
                            Title="Гостьова команда" />

                        <PropertyColumn
                            Property="match => match.HomeScore"
                            Title="Голи господарів" />

                        <PropertyColumn
                            Property="match => match.AwayScore"
                            Title="Голи гостей" />

                        <TemplateColumn Title="Дата матчу"
                                        Context="match">
                            @match.MatchDate.ToString("dd.MM.yyyy")
                        </TemplateColumn>

                        <PropertyColumn
                            Property="match => match.Stadium"
                            Title="Стадіон" />

                        <TemplateColumn Title="Турнір"
                                        Context="match">
                            @(string.IsNullOrWhiteSpace(match.Competition)
                                ? "Не вказано"
                                : match.Competition)
                        </TemplateColumn>

                        <TemplateColumn Title="Статус" Context="match">
                            @GetStatusText(match.Status)
                        </TemplateColumn>

                        <TemplateColumn Title="Дії"
                                        Context="match">

                            <div class="d-flex flex-wrap align-items-center gap-2">

                                <a href="@($"/footballmatches/edit?id={match.Id}")"
                                   class="btn btn-sm btn-primary animated-btn text-nowrap">
                                    Редагувати
                                </a>

                                <a href="@($"/footballmatches/details?id={match.Id}")"
                                   class="btn btn-sm animated-btn text-white text-nowrap"
                                   style="background-color:#fd7e14;">
                                    Деталі
                                </a>

                                <a href="@($"/footballmatches/delete?id={match.Id}")"
                                   class="btn btn-sm btn-danger animated-btn text-nowrap">
                                    Видалити
                                </a>
                            </div>
                        </TemplateColumn>

                    </QuickGrid>
                </div>

                <div class="d-xxl-none">
                    <div class="row g-3">
                    @foreach (var match in matches)
                    {
                        <div class="col-12 col-lg-6">
                        <div class="card border shadow-sm h-100">
                            <div class="card-body p-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                    <strong class="text-break">@match.HomeTeam — @match.AwayTeam</strong>
                                    <span class="badge bg-secondary">@GetStatusText(match.Status)</span>
                                </div>

                                <div class="text-center fs-3 fw-bold mb-3">
                                    @match.HomeScore : @match.AwayScore
                                </div>

                                <dl class="row small mb-3">
                                    <dt class="col-5">Дата матчу</dt>
                                    <dd class="col-7 text-break">@match.MatchDate.ToString("dd.MM.yyyy")</dd>
                                    <dt class="col-5">Стадіон</dt>
                                    <dd class="col-7 text-break">@match.Stadium</dd>
                                    <dt class="col-5">Турнір</dt>
                                    <dd class="col-7 text-break">@(string.IsNullOrWhiteSpace(match.Competition) ? "Не вказано" : match.Competition)</dd>
                                </dl>

                                <div class="d-flex flex-wrap gap-2">
                                    <a href="@($"/footballmatches/edit?id={match.Id}")"
                                       class="btn btn-sm btn-primary animated-btn flex-grow-1">Редагувати</a>
                                    <a href="@($"/footballmatches/details?id={match.Id}")"
                                       class="btn btn-sm animated-btn text-white flex-grow-1"
                                       style="background-color:#fd7e14;">Деталі</a>
                                    <a href="@($"/footballmatches/delete?id={match.Id}")"
                                       class="btn btn-sm btn-danger animated-btn flex-grow-1">Видалити</a>
                                </div>
                            </div>
                        </div>
                        </div>
                    }
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap
                    justify-content-between
                    align-items-center gap-3 mt-4 mb-3">

            <span class="text-muted small">
                Сторінка @currentPage із @totalPages
            </span>

            <div class="d-flex flex-wrap align-items-center gap-2">

                @if (currentPage > 1)
                {
                    <a href="@BuildPageUrl(currentPage - 1)"
                        data-enhance-nav="false"
                        class="btn btn-warning animated-btn">
                        ← Назад
                    </a>
                }

                <span class="badge bg-light text-dark border px-3 py-2">
                    @currentPage / @totalPages
                </span>

                @if (currentPage < totalPages)
                {
                    <a href="@BuildPageUrl(currentPage + 1)"
                            data-enhance-nav="false"
                            class="btn btn-warning animated-btn">
                            Далі →
                    </a>
                }
            </div>
        </div>
    }
</div>

@code {
    private static string GetStatusText(MatchStatus status) =>
        status.ToString() switch
        {
            "Scheduled" => "Заплановано",
            "InProgress" => "Триває",
            "Finished" => "Завершено",
            "Completed" => "Завершено",
            "Cancelled" => "Скасовано",
            "Postponed" => "Перенесено",
            _ => status.ToString()
        };

    private IQueryable<FootballMatch> matches =
        Enumerable.Empty<FootballMatch>().AsQueryable();

    private List<Team> teams = new();

    private int pageSize => Math.Max(1, Config.GetValue<int?>("FootballMatches:PageSize") ?? 10);

    private int currentPage = 1;
    private int totalPages = 1;
    private int totalMatches = 0;

    private bool loaded = false;

    [SupplyParameterFromQuery(Name = "saved")]
    public bool Saved { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "teamId")]
    public int? TeamId { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;

        await using var context =
            await DbFactory.CreateDbContextAsync();

        teams = await context.Set<Team>()
            .AsNoTracking()
            .OrderBy(t => t.Name)
            .ToListAsync();

        IQueryable<FootballMatch> query =
            context.FootballMatches
                .AsNoTracking()
                .Include(m => m.HomeTeamReference)
                .Include(m => m.AwayTeamReference)
                .Include(m => m.StadiumReference);

        // Case-insensitive search
        if (!string.IsNullOrWhiteSpace(Search))
        {
            string searchText =
                Search.Trim().ToLowerInvariant();

            query = query.Where(m =>
                m.HomeTeamSearch.Contains(searchText));
        }

        // Filter by home team
        if (TeamId.HasValue)
        {
            int selectedTeamId = TeamId.Value;

            query = query.Where(m =>
                m.HomeTeamId == selectedTeamId);
        }

        // Database sorting
        query = Sort switch
        {
            "date_asc" => query
                .OrderBy(m => m.MatchDate)
                .ThenBy(m => m.Id),

            "score_desc" => query
                .OrderByDescending(m => m.HomeScore)
                .ThenBy(m => m.Id),

            "score_asc" => query
                .OrderBy(m => m.HomeScore)
                .ThenBy(m => m.Id),

            "team_asc" => query
                .OrderBy(m => m.HomeTeam)
                .ThenBy(m => m.Id),

            "team_desc" => query
                .OrderByDescending(m => m.HomeTeam)
                .ThenBy(m => m.Id),

            _ => query
                .OrderByDescending(m => m.MatchDate)
                .ThenBy(m => m.Id)
        };

        totalMatches = await query.CountAsync();

        totalPages = Math.Max(
            1,
            (int)Math.Ceiling(totalMatches / (double)pageSize)
        );

        currentPage = Math.Clamp(
            Page ?? 1,
            1,
            totalPages
        );

        List<FootballMatch> result = await query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();

        matches = result.AsQueryable();

        loaded = true;
    }

    private string BuildPageUrl(int page)
    {
        var parameters = new List<string>
        {
            $"page={page}"
        };

        if (!string.IsNullOrWhiteSpace(Search))
        {
            parameters.Add(
                $"search={Uri.EscapeDataString(Search)}"
            );
        }

        if (TeamId.HasValue)
        {
            parameters.Add($"teamId={TeamId.Value}");
        }

        if (!string.IsNullOrWhiteSpace(Sort))
        {
            parameters.Add(
                $"sort={Uri.EscapeDataString(Sort)}"
            );
        }

        return "/footballmatches?" +
            string.Join("&", parameters);
    }
}
