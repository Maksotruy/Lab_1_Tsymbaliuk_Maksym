
@page "/footballmatches"

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using FootballMatches.Models
@using FootballMatches.Data

@inject IDbContextFactory<FootballMatchesContext> DbFactory

<PageTitle>Football Matches</PageTitle>

<h1>Football Match List</h1>
<hr />

<div class="mb-4">
    <a href="/footballmatches/create"
       class="btn btn-success animated-btn">
        ➕ Add Football Match
    </a>
</div>

<form method="get" class="row g-2 mb-4">

    <div class="col-md-3">
        <label for="search" class="form-label">
            Search Home Team
        </label>

        <input id="search"
               type="text"
               name="search"
               value="@Search"
               class="form-control"
               placeholder="Enter home team name" />
    </div>

    <div class="col-md-3">
        <label for="teamId" class="form-label">
            Filter by Team
        </label>

        <select id="teamId"
                name="teamId"
                class="form-select">

            <option value="">
                All Teams
            </option>

            @foreach (var team in teams)
            {
                <option value="@team.Id"
                        selected="@(TeamId == team.Id)">
                    @team.Name
                </option>
            }

        </select>
    </div>

    <div class="col-md-3">
        <label for="sort" class="form-label">
            Sort By
        </label>

        <select id="sort"
                name="sort"
                class="form-select">

            <option value="date_desc"
                    selected="@(Sort == "date_desc" || string.IsNullOrEmpty(Sort))">
                Date (Newest First)
            </option>

            <option value="date_asc"
                    selected="@(Sort == "date_asc")">
                Date (Oldest First)
            </option>

            <option value="score_desc"
                    selected="@(Sort == "score_desc")">
                Home Score (Highest First)
            </option>

            <option value="score_asc"
                    selected="@(Sort == "score_asc")">
                Home Score (Lowest First)
            </option>

            <option value="team_asc"
                    selected="@(Sort == "team_asc")">
                Home Team (A-Z)
            </option>

            <option value="team_desc"
                    selected="@(Sort == "team_desc")">
                Home Team (Z-A)
            </option>

        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">

        <button type="submit"
                class="btn btn-primary animated-btn">
            🔍 Search
        </button>

        <a href="/footballmatches"
           class="btn btn-secondary animated-btn">
            Reset
        </a>

    </div>

</form>

@if (!loaded)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive football-table">

        <QuickGrid Class="table table-striped table-hover align-middle"
                   Items="matches">

            <PropertyColumn
                Property="match => match.HomeTeam"
                Title="Home Team" />

            <PropertyColumn
                Property="match => match.AwayTeam"
                Title="Away Team" />

            <PropertyColumn
                Property="match => match.HomeScore"
                Title="Home Score" />

            <PropertyColumn
                Property="match => match.AwayScore"
                Title="Away Score" />

            <PropertyColumn
                Property="match => match.MatchDate"
                Title="Match Date" />

            <PropertyColumn
                Property="match => match.Stadium"
                Title="Stadium" />

            <TemplateColumn Title="Competition" Context="match">
                @(string.IsNullOrWhiteSpace(match.Competition)
                    ? "Not specified"
                    : match.Competition)
            </TemplateColumn>

            <PropertyColumn
                Property="match => match.Status"
                Title="Status" />

            <TemplateColumn Title="Actions" Context="match">

                <div class="d-flex flex-nowrap align-items-center gap-1">

                    <a href="@($"/footballmatches/edit?id={match.Id}")"
                       class="btn btn-sm btn-primary animated-btn text-nowrap">
                        ✏️ Edit
                    </a>

                    <a href="@($"/footballmatches/details?id={match.Id}")"
                       class="btn btn-sm animated-btn text-white text-nowrap"
                       style="background-color: #fd7e14; border-color: #fd7e14;">
                        👁 Details
                    </a>

                    <a href="@($"/footballmatches/delete?id={match.Id}")"
                       class="btn btn-sm btn-danger animated-btn text-nowrap">
                        🗑 Delete
                    </a>

                </div>

            </TemplateColumn>

        </QuickGrid>

    </div>

    @if (totalMatches == 0)
    {
        <p class="mt-3 text-muted">
            No football matches found.
        </p>
    }

    <div class="d-flex justify-content-start align-items-center gap-3 mt-4 mb-3">

        @if (currentPage > 1)
        {
            <a href="@BuildPageUrl(currentPage - 1)"
               class="btn btn-warning animated-btn">
                ← Previous
            </a>
        }

        <span class="fw-semibold text-center"
              style="min-width: 110px; white-space: nowrap;">
            Page @currentPage of @totalPages
        </span>

        @if (currentPage < totalPages)
        {
            <a href="@BuildPageUrl(currentPage + 1)"
               class="btn btn-warning animated-btn">
                Next →
            </a>
        }

    </div>
}

@code {
    private IQueryable<FootballMatch> matches =
        Enumerable.Empty<FootballMatch>().AsQueryable();

    private List<Team> teams = new();

    private const int pageSize = 10;

    private int currentPage = 1;
    private int totalPages = 1;
    private int totalMatches = 0;

    private bool loaded = false;

    [SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "teamId")]
    public int? TeamId { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;

        await using var context =
            await DbFactory.CreateDbContextAsync();

        teams = await context.Set<Team>()
            .AsNoTracking()
            .OrderBy(t => t.Name)
            .ToListAsync();

        IQueryable<FootballMatch> query =
            context.FootballMatches
                .AsNoTracking()
                .Include(m => m.HomeTeamReference)
                .Include(m => m.AwayTeamReference)
                .Include(m => m.StadiumReference);

        // Lab 8: Case-insensitive search.
        if (!string.IsNullOrWhiteSpace(Search))
        {
            string searchText =
                Search.Trim().ToLowerInvariant();

            query = query.Where(m =>
                m.HomeTeamSearch.Contains(searchText));
        }

        // Lab 8: Filter by home team.
        if (TeamId.HasValue)
        {
            int selectedTeamId = TeamId.Value;

            query = query.Where(m =>
                m.HomeTeamId == selectedTeamId);
        }

        // Lab 8: Sorting is performed by the database.
        query = Sort switch
        {
            "date_asc" => query
                .OrderBy(m => m.MatchDate)
                .ThenBy(m => m.Id),

            "score_desc" => query
                .OrderByDescending(m => m.HomeScore)
                .ThenBy(m => m.Id),

            "score_asc" => query
                .OrderBy(m => m.HomeScore)
                .ThenBy(m => m.Id),

            "team_asc" => query
                .OrderBy(m => m.HomeTeam)
                .ThenBy(m => m.Id),

            "team_desc" => query
                .OrderByDescending(m => m.HomeTeam)
                .ThenBy(m => m.Id),

            _ => query
                .OrderByDescending(m => m.MatchDate)
                .ThenBy(m => m.Id)
        };

        // Count records after filtering.
        totalMatches = await query.CountAsync();

        totalPages = Math.Max(
            1,
            (int)Math.Ceiling(totalMatches / (double)pageSize)
        );

        currentPage = Math.Clamp(
            Page ?? 1,
            1,
            totalPages
        );

        // Load only the records needed for this page.
        List<FootballMatch> result = await query
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();

        matches = result.AsQueryable();

        loaded = true;
    }

    private string BuildPageUrl(int page)
    {
        var parameters = new List<string>
        {
            $"page={page}"
        };

        if (!string.IsNullOrWhiteSpace(Search))
        {
            parameters.Add(
                $"search={Uri.EscapeDataString(Search)}"
            );
        }

        if (TeamId.HasValue)
        {
            parameters.Add($"teamId={TeamId.Value}");
        }

        if (!string.IsNullOrWhiteSpace(Sort))
        {
            parameters.Add(
                $"sort={Uri.EscapeDataString(Sort)}"
            );
        }

        return "/footballmatches?" +
            string.Join("&", parameters);
    }
}
