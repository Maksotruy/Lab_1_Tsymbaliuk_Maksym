
@page "/summary"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Data
@using FootballMatches.Services

@inject IDbContextFactory<FootballMatchesContext> DbFactory

<PageTitle>Статистика матчів | FootballMatches</PageTitle>

<div class="statistics-page">

    <div class="statistics-header">
        <div>
            <h1>Статистика матчів</h1>
            <p>
                Загальний огляд футбольних результатів,
                команд та активності за місяцями.
            </p>
        </div>

        <span class="statistics-header-badge">
            ⚽ ФУТБОЛЬНА АНАЛІТИКА
        </span>
    </div>

    @if (loading)
    {
        <div class="statistics-empty">
            <div class="spinner-border text-primary"
                 role="status">
                <span class="visually-hidden">
                    Завантаження...
                </span>
            </div>

            <p class="mt-3 mb-0">
                Завантаження статистики...
            </p>
        </div>
    }
    else if (total.Count == 0)
    {
        <div class="statistics-empty">
            <div class="statistics-empty-icon">⚽</div>

            <h3>Матчів поки немає</h3>

            <p>
                Додайте перший футбольний матч,
                щоб побачити статистику.
            </p>

            <a href="/footballmatches"
               class="btn btn-primary animated-btn">
                Переглянути матчі
            </a>
        </div>
    }
    else
    {
        <div class="statistics-grid">

            <div class="statistics-card">
                <div class="statistics-card-icon icon-blue">⚽</div>

                <div class="statistics-card-label">
                    Усього матчів
                </div>

                <div class="statistics-card-value">
                    @total.Count
                </div>

                <div class="statistics-card-description">
                    Матчі в базі даних
                </div>
            </div>

            <div class="statistics-card">
                <div class="statistics-card-icon icon-green">🥅</div>

                <div class="statistics-card-label">
                    Голи господарів
                </div>

                <div class="statistics-card-value">
                    @total.Total
                </div>

                <div class="statistics-card-description">
                    Загальна кількість забитих голів
                </div>
            </div>

            <div class="statistics-card">
                <div class="statistics-card-icon icon-orange">🏆</div>

                <div class="statistics-card-label">
                    Домашні команди
                </div>

                <div class="statistics-card-value">
                    @byTeam.Count
                </div>

                <div class="statistics-card-description">
                    Команди, які грали вдома
                </div>
            </div>

            <div class="statistics-card">
                <div class="statistics-card-icon icon-purple">📅</div>

                <div class="statistics-card-label">
                    Активні місяці
                </div>

                <div class="statistics-card-value">
                    @byMonth.Count
                </div>

                <div class="statistics-card-description">
                    Місяці з проведеними матчами
                </div>
            </div>

        </div>

        <section class="statistics-section">

            <div class="statistics-section-heading">
                <div>
                    <h2>🏆 Статистика команд</h2>

                    <p>
                        Кількість матчів та голів,
                        забитих домашніми командами.
                    </p>
                </div>

                <span class="statistics-count">
                    @byTeam.Count команд
                </span>
            </div>

            <div class="statistics-table-wrapper">

                <table class="statistics-table">
                    <thead>
                        <tr>
                            <th>№</th>
                            <th>Домашня команда</th>
                            <th>Матчі</th>
                            <th>Забиті голи</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < byTeam.Count; i++)
                        {
                            var row = byTeam[i];

                            <tr>
                                <td class="statistics-position">
                                    @(i + 1)
                                </td>

                                <td>
                                    <span class="statistics-team-name">
                                        @row.Name
                                    </span>
                                </td>

                                <td>
                                    <span class="statistics-match-count">
                                        @row.Count
                                    </span>
                                </td>

                                <td>
                                    <span class="statistics-goal-count">
                                        @row.Total
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <td colspan="2">
                                Усього
                            </td>

                            <td>@total.Count</td>
                            <td>@total.Total</td>
                        </tr>
                    </tfoot>
                </table>

            </div>
        </section>

        <section class="statistics-section">

            <div class="statistics-section-heading">
                <div>
                    <h2>📅 Статистика за місяцями</h2>

                    <p>
                        Динаміка футбольних матчів
                        за календарними місяцями.
                    </p>
                </div>

                <span class="statistics-count">
                    @byMonth.Count періодів
                </span>
            </div>

            <div class="statistics-table-wrapper">

                <table class="statistics-table">
                    <thead>
                        <tr>
                            <th>Період</th>
                            <th>Матчі</th>
                            <th>Забиті голи</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var row in byMonth)
                        {
                            <tr>
                                <td>
                                    <span class="statistics-team-name">
                                        @row.Name
                                    </span>
                                </td>

                                <td>
                                    <span class="statistics-match-count">
                                        @row.Count
                                    </span>
                                </td>

                                <td>
                                    <span class="statistics-goal-count">
                                        @row.Total
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </section>
    }

</div>

@code {
    private bool loading = true;

    private List<SummaryRow> byTeam = new();
    private List<SummaryRow> byMonth = new();

    private SummaryRow total = new("Усього", 0, 0);

    protected override async Task OnInitializedAsync()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        var query = db.FootballMatches.AsNoTracking();

        byTeam = await SummaryCalculator.ByTeamAsync(query);
        byMonth = await SummaryCalculator.ByMonthAsync(query);
        total = await SummaryCalculator.TotalAsync(query);

        loading = false;
    }
}
