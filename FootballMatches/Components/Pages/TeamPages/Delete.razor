
@page "/teams/delete"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models

@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалення команди | FootballMatches</PageTitle>

<h1>Видалення команди</h1>
<hr />

@if (team is null)
{
    <p><em>Завантаження...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-8">

            <div class="alert alert-danger" role="alert">
                <strong>Увага!</strong>
                Ви впевнені, що хочете видалити цю команду?
                Цю дію неможливо скасувати.
            </div>

            <div class="card mb-4">

                <div class="card-header">
                    <h5 class="mb-0">
                        Інформація про команду
                    </h5>
                </div>

                <div class="card-body">
                    <dl class="row">

                        <dt class="col-sm-4">
                            Назва команди
                        </dt>

                        <dd class="col-sm-8">
                            @team.Name
                        </dd>

                        <dt class="col-sm-4">
                            Країна
                        </dt>

                        <dd class="col-sm-8">
                            @team.Country
                        </dd>

                    </dl>
                </div>

            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger"
                     role="alert">
                    @error
                </div>
            }

            <EditForm method="post"
                      Model="team"
                      OnSubmit="DeleteTeam"
                      FormName="delete"
                      Enhance
                      class="mt-4">

                <input type="hidden"
                       name="Id"
                       value="@team.Id" />

                <div class="d-flex flex-wrap gap-2">

                    <button type="submit"
                            class="btn btn-danger animated-btn">
                        🗑 Видалити команду
                    </button>

                    <a href="/teams"
                       class="btn btn-secondary animated-btn">
                        ← Повернутися до списку
                    </a>

                </div>

            </EditForm>

        </div>
    </div>
}

@code {
    private Team? team;
    private string? error;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context =
            await DbFactory.CreateDbContextAsync();

        team = await context.Team
            .AsNoTracking()
            .FirstOrDefaultAsync(t => t.Id == Id);

        if (team is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteTeam(EditContext editContext)
    {
        error = null;

        if (team is null)
        {
            error = "Не вдалося завантажити дані команди.";
            return;
        }

        await using var context =
            await DbFactory.CreateDbContextAsync();

        var existingTeam = await context.Team
            .FirstOrDefaultAsync(t => t.Id == team.Id);

        if (existingTeam is null)
        {
            error = "Цієї команди більше немає в базі даних.";
            return;
        }

        // Перевірка, чи бере команда участь у футбольних матчах.
        var isUsed = await context.FootballMatches
            .AnyAsync(m =>
                m.HomeTeamId == existingTeam.Id ||
                m.AwayTeamId == existingTeam.Id);

        if (isUsed)
        {
            error = "Неможливо видалити цю команду, оскільки вона бере участь в одному або декількох футбольних матчах.";
            return;
        }

        context.Team.Remove(existingTeam);

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            error = "Не вдалося видалити команду. Спробуйте ще раз.";
            return;
        }

        NavigationManager.NavigateTo("/teams");
    }
}
