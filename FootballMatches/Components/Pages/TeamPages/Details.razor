
@page "/teams/details"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models

@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Team Details</PageTitle>

<h1>Team Details</h1>
<hr />

@if (team is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-8">

            <div class="card mb-4">

                <div class="card-header">
                    <h5 class="mb-0">
                        Team Information
                    </h5>
                </div>

                <div class="card-body">
                    <dl class="row">

                        <dt class="col-sm-4">
                            Name
                        </dt>

                        <dd class="col-sm-8">
                            @team.Name
                        </dd>

                        <dt class="col-sm-4">
                            Country
                        </dt>

                        <dd class="col-sm-8">
                            @team.Country
                        </dd>

                    </dl>
                </div>

            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">

                <a href="@($"/teams/edit?id={team.Id}")"
                   class="btn btn-primary animated-btn">
                    ✏️ Edit
                </a>

                <a href="/teams"
                   class="btn btn-secondary animated-btn">
                    ← Back to List
                </a>

            </div>

        </div>
    </div>
}

@code {
    private Team? team;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context =
            await DbFactory.CreateDbContextAsync();

        team = await context.Team
            .AsNoTracking()
            .FirstOrDefaultAsync(t => t.Id == Id);

        if (team is null)
        {
            NavigationManager.NotFound();
        }
    }
}
