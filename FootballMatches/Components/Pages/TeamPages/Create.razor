
@page "/teams/create"

@using Microsoft.EntityFrameworkCore
@using FootballMatches.Models

@inject IDbContextFactory<FootballMatches.Data.FootballMatchesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Team</PageTitle>

<h1>Create Team</h1>
<hr />

<div class="row">
    <div class="col-md-4">

        <EditForm method="post"
                  Model="Team"
                  OnValidSubmit="AddTeam"
                  FormName="create"
                  Enhance>

            <DataAnnotationsValidator />

            <ValidationSummary class="text-danger"
                               role="alert" />

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger"
                     role="alert">
                    @error
                </div>
            }

            <div class="mb-3">
                <label for="name" class="form-label">
                    Name <span class="text-danger">*</span>
                </label>

                <InputText id="name"
                           @bind-Value="Team.Name"
                           class="form-control"
                           aria-required="true" />

                <ValidationMessage
                    For="() => Team.Name"
                    class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="country" class="form-label">
                    Country <span class="text-danger">*</span>
                </label>

                <InputText id="country"
                           @bind-Value="Team.Country"
                           class="form-control"
                           aria-required="true" />

                <ValidationMessage
                    For="() => Team.Country"
                    class="text-danger" />
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">

                <button type="submit"
                        class="btn btn-success animated-btn">
                    ✔ Create Team
                </button>

                <a href="/teams"
                   class="btn btn-secondary animated-btn">
                    ← Back to List
                </a>

            </div>

        </EditForm>

    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Team Team { get; set; } = default!;

    private string? error;

    protected override void OnInitialized()
    {
        Team ??= new();
    }

    private async Task AddTeam()
    {
        error = null;

        await using var context =
            await DbFactory.CreateDbContextAsync();

        context.Team.Add(Team);

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            error = "Unable to create the team. Please try again.";
            return;
        }

        NavigationManager.NavigateTo("/teams");
    }
}
